# Pure regenerable pipeline outputs -- re-run run_pipeline.py / export_akn.py
# / export_markdown.py to recreate, never needed just to run review.py, so
# there's nothing to gain from committing them.
data/extracted/
data/diagnostics/
data/akn/
data/markdown/

# export_static_site.py's own output -- rebuilt by .github/workflows/pages.yml
# on every push, never committed.
_site/

# run_ai_review.py's own stdout/stderr, captured per-Act by dashboard.py
# so a failed AI scan's reason (e.g. Ollama not installed) is visible in
# the UI -- not durable state, just the latest run's output.
data/ai_scan_logs/

# data/ai_parsed/<act>.json (the raw parse) and data/legislation.db (the
# durable, human-created review state overlaid on it -- verified rows,
# link annotations, the correction log; see ai_pipeline/db.py's module
# docstring) ARE committed, deliberately, as a pair: review.py's verified
# rows are keyed by a *positional* index into that exact parse, so a
# clone that had the DB but regenerated ai_parsed from a later parser
# version could silently misalign verified content with the wrong
# provisions. Committing both together means a fresh clone (e.g. a
# temporary cloud dev environment) can open review.py immediately with
# your actual progress intact, no pipeline re-run and no drift risk. See
# deploy/README.md's "Working from a remote dev environment" section.
#
# Run `python checkpoint_db.py` before committing data/legislation.db --
# it's opened in WAL mode, so a recent write can sit in the -wal file
# below (gitignored, along with -shm) rather than the main file yet;
# checkpointing folds it in so the committed file is always complete.
data/legislation.db-wal
data/legislation.db-shm

# Superseded by data/legislation.db above; only relevant if you still
# have pre-migration JSON files around (see migrate_json_to_sqlite.py).
data/verified/
data/links/
data/corrections.jsonl

__pycache__/
*.pyc
.idea/
.pytest_cache/

# dashboard.py's persisted login credentials (username + salted password
# hash, written after the forced first-login password change) -- never
# commit this, even though it's a hash rather than the plain password.
.dashboard_auth.json

# deploy/dashboard.env.example is tracked as a template; the real copy
# (deploy/README.md step 4) holds actual credentials and must not be.
deploy/dashboard.env
