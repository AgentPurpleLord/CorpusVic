# Regenerable pipeline outputs (re-run run_pipeline.py / export_akn.py to recreate)
data/extracted/
data/ai_parsed/
data/diagnostics/
data/akn/
data/markdown/

# The durable, human-created review data (verified state, link
# annotations, the correction log -- see ai_pipeline/db.py's module
# docstring) now lives in this one SQLite file instead of data/verified/,
# data/links/, and data/corrections.jsonl. Not committed here either --
# a binary database file doesn't diff/merge meaningfully in git -- but
# unlike the regenerable outputs above, this one genuinely can't be
# recreated if lost, so back it up separately (see deploy/README.md).
data/legislation.db
data/legislation.db-wal
data/legislation.db-shm

# Superseded by data/legislation.db above; only relevant if you still
# have pre-migration JSON files around (see migrate_json_to_sqlite.py).
data/verified/
data/links/
data/corrections.jsonl

__pycache__/
*.pyc
.idea/
.pytest_cache/

# dashboard.py's persisted login credentials (username + salted password
# hash, written after the forced first-login password change) -- never
# commit this, even though it's a hash rather than the plain password.
.dashboard_auth.json

# deploy/dashboard.env.example is tracked as a template; the real copy
# (deploy/README.md step 4) holds actual credentials and must not be.
deploy/dashboard.env
