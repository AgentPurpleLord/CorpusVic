[Unit]
Description=Legislation pipeline dashboard
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/corpusvic
# The "-" makes a missing file non-fatal: dashboard.py's own forced
# first-login password change (see dashboard.py's module docstring) means
# this service still comes up safely without it, it just starts on the
# built-in placeholder credentials instead of whatever you'd put here.
EnvironmentFile=-/opt/corpusvic/deploy/dashboard.env
# --base-path must match the path Caddy proxies (see
# deploy/Caddyfile.example): the dashboard builds every link it hands
# a browser from it. Drop it to serve at the domain root instead.
ExecStart=/opt/corpusvic/.venv/bin/python3 -m corpus.web.dashboard --host 127.0.0.1 --port 8000 --base-path /admin
Restart=on-failure
RestartSec=5

# The public site comes first on a shared machine. This service and every
# parse it starts (they run in its cgroup) get a fifth of the default share
# of CPU and disk while the site wants them, and all of it while the site
# is idle -- a parse running made the site stop answering. See also
# CPUWeight in public.service. Takes effect once the unit is copied to
# /etc/systemd/system and `systemctl daemon-reload` run.
CPUWeight=20
IOWeight=20

# Bound to loopback only (see --host above) -- Caddy is the only thing
# facing the internet; see deploy/Caddyfile.example.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/corpusvic

[Install]
WantedBy=multi-user.target
