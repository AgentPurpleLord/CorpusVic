#!/bin/sh
# Auto-checkpoints data/legislation.db's WAL into the main file whenever
# it's part of this commit, so the committed snapshot is always complete
# -- see checkpoint_db.py's own docstring for why this matters. Git
# hooks don't travel with a clone, which is why this lives here as a
# tracked template instead of directly at .git/hooks/pre-commit -- install
# it once per environment:
#
#   cp deploy/pre-commit.hook.example .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# See deploy/README.md's "Working from a remote dev environment" section.
if git diff --cached --name-only | grep -q '^data/legislation\.db$'; then
    python3 checkpoint_db.py || exit 1
    git add data/legislation.db
fi
