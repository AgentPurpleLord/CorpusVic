#!/bin/sh
# Two jobs, both of them about what a commit from this checkout carries.
#
# Git hooks don't travel with a clone, so this is a tracked file that git
# is pointed at rather than a copy inside .git/ -- once per environment:
#
#   git config core.hooksPath deploy/githooks
#
# It used to be a template copied to .git/hooks/pre-commit, and the copy
# went stale: the restructure renamed the modules below, the server's copy
# kept calling the old paths, and every commit the dashboard tried to make
# was refused. A pull updates this file; it could not update that one.
#
# (core.hooksPath replaces the hooks directory wholesale, so any other
# hook in .git/hooks/ stops running once it is set.)
#
# See deploy/README.md's "Working from a remote dev environment" section.

# ---------------------------------------------------------------------
# 1. Never commit a private key.
#
# On the server the `dashboard` service account's home directory IS this
# checkout, so the GitHub deploy key sits at .ssh/id_ed25519 -- inside
# the working tree. .gitignore covers it, and this covers the times the
# ignore rule does not: `git add -f`, a rule somebody rewrote, a key
# saved somewhere new. It has happened once; GitHub's push protection
# caught it, which is a backstop rather than a plan.
#
# Checked by content, not by filename, because the filename is the part
# that varies.
staged=$(git diff --cached --name-only --diff-filter=ACM)
for path in $staged; do
    case "$path" in
        .ssh/*|*/.ssh/*)
            echo "pre-commit: refusing to commit $path" >&2
            echo "  Anything under .ssh/ belongs to the machine, not the repository." >&2
            exit 1
            ;;
    esac
    # -I so a binary file is never matched on a coincidence; the index
    # copy, not the working tree, because that is what would be committed.
    #
    # [A-Z ]* rather than .* on purpose. A real banner names the format in
    # capitals -- OPENSSH, RSA, EC, ENCRYPTED, or nothing at all -- and
    # the narrower pattern has the useful property that THIS LINE does not
    # match itself. With .* the hook refused the commit that introduced
    # it, which is the way a guard gets uninstalled.
    if git show ":$path" 2>/dev/null | grep -qI -- "-----BEGIN [A-Z ]*PRIVATE KEY-----"; then
        echo "pre-commit: refusing to commit $path -- it contains a private key." >&2
        echo "  If this is a test fixture and the key is not real, commit with" >&2
        echo "  --no-verify. If it is real, it does not belong in git at all:" >&2
        echo "  unstage it, and rotate the key if it was ever pushed." >&2
        exit 1
    fi
done

# ---------------------------------------------------------------------
# 2. Keep a review commit whole.
#
# The review work lives in data/legislation.db while you work and travels
# as text in data/review/**.jsonl. Two things have to happen between
# those, and both are easy to forget by hand:
#
#   - the database is opened in WAL mode, so a recent write can still be
#     sitting in data/legislation.db-wal rather than in the file an
#     export reads (see corpus/storage/checkpoint_db.py);
#   - the export itself, or the commit carries whatever data/review/ held
#     the last time anything ran one.
#
# corpus/review/sync.py does both before every commit it makes, which covers the
# dashboard's buttons. This covers committing from a terminal.
#
# Only when review files are already part of the commit, so that a code
# commit never quietly sweeps up a day's reviewing.
if echo "$staged" | grep -q '^data/review/'; then
    # The venv's python where there is one. On the server the service runs
    # .venv/bin/python3 (deploy/dashboard.service), but systemd's default
    # PATH does not include it, so a bare `python3` here is a different
    # interpreter from the one everything else uses.
    root=$(git rev-parse --show-toplevel)
    PY="$root/.venv/bin/python3"
    [ -x "$PY" ] || PY=python3
    # Always `-m`, never a file path: that is what lets these modules move
    # without this hook having to be reinstalled.
    "$PY" -m corpus.storage.checkpoint_db || exit 1
    "$PY" -m corpus.review.review_sync export || exit 1
    git add data/review
fi
