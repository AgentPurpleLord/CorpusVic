[Unit]
Description=CorpusVic public site
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/corpusvic
# SITE_PASSWORD. Without it public.py refuses to start rather than
# serving the corpus to anyone who asks -- pass --open below to publish
# openly on purpose.
EnvironmentFile=-/opt/corpusvic/deploy/site.env
ExecStart=/opt/corpusvic/.venv/bin/python3 -m corpus.web.public --host 127.0.0.1 --port 8001
# always, not on-failure: unlike the dashboard there is no restart button
# here, and a public site should come back from a clean exit too.
Restart=always
RestartSec=2

# Bound to loopback (see --host); Caddy is the only thing facing the
# internet. See deploy/Caddyfile.example.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# data/ has to be writable, and not because this process writes anything.
# data/legislation.db is in WAL mode, and sqlite cannot open a WAL
# database at all -- not even read-only -- without being able to create
# the -shm and -wal files beside it. With no ReadWritePaths the service
# does not start: it fails with "attempt to write a readonly database"
# and, with Restart=always, does so repeatedly.
#
# So the kernel's guarantee here is narrower than "writes nothing": it is
# that nothing outside data/ can be touched. What keeps this app
# read-only in the sense that matters is its route table, where every
# route is a GET and a test fails if that stops being true.
#
# The search index needs none of this (it is in the ordinary rollback
# journal mode and reads happily from a read-only directory); it is only
# in data/ because that is where it lives.
ReadWritePaths=/opt/corpusvic/data

[Install]
WantedBy=multi-user.target
