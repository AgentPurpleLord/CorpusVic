# Copy this file to deploy/dashboard.env (which is gitignored -- never
# commit the copy) and fill in real values, or leave DASHBOARD_PASSWORD
# blank/unset entirely to use dashboard.py's forced first-login password
# change instead (see its module docstring for exactly how that works).
DASHBOARD_USERNAME=AgentPurpleLord
DASHBOARD_PASSWORD=

# The systemd unit of the public site, for the dashboard's "Restart the
# public site" button. Only needed if you installed it under a different
# name -- deploy/README.md calls it corpusvic-public.service, which is
# the default. The button needs no other configuration: both services run
# as the same user, so restarting is a signal rather than a privileged
# call.
#PUBLIC_SERVICE_UNIT=corpusvic-public.service
