# Copy this to /etc/caddy/Caddyfile on the VPS (not inside this repo
# checkout) and replace the domain with your own. Caddy obtains and
# renews a Let's Encrypt certificate for it automatically -- no manual
# certbot/openssl steps -- as long as:
#   - the domain's DNS A (and/or AAAA) record points at this server's
#     public IP, and
#   - ports 80 and 443 are open inbound (see deploy/README.md's firewall
#     step) -- 80 is needed for the ACME HTTP challenge even though
#     everything ends up served over HTTPS.

corpusvic.au, www.corpusvic.au {
    # The admin tool, at /admin. handle (not handle_path) so the prefix
    # is passed through rather than stripped: the dashboard is told the
    # same prefix with --base-path and builds its own links from it, so
    # stripping here would leave every link it emits pointing one level
    # too high.
    handle /admin* {
        reverse_proxy 127.0.0.1:8000
    }

    # Everything else is the public site (public.py), served live from
    # the database on its own port. A second, read-only process rather
    # than part of the dashboard: the dashboard restarts itself after a
    # pull, and sharing one process would take the corpus down with it.
    #
    # To go back to serving the static build instead -- which is the
    # rollback, and it is one block:
    #     handle {
    #         root * /opt/corpusvic/_site
    #         try_files {path} {path}/ {path}/index.html
    #         file_server
    #     }
    handle {
        reverse_proxy 127.0.0.1:8001
    }
}

# Reaching the server by its bare IP, before DNS points at it.
#
# The block above matches on hostname, so a request carrying
# "Host: 203.0.113.10" matches nothing and Caddy answers 404. That is not
# a fault -- it is what a hostname-matched site does -- but while you are
# still setting DNS up it looks exactly like a server that is down.
#
# This answers on anything else, over plain HTTP, and says where to go.
# It serves nothing: there is no certificate for an IP address, so
# everything here crosses the network in the clear, and both the site and
# the dashboard now ask for a passphrase. Handing a login form to
# somebody over plain HTTP invites them to type a passphrase into it.
#
# It used to serve the static build here, which was harmless while the
# gate was encryption baked into pages that were already ciphertext. It
# stopped being harmless the moment the passphrase was something a
# visitor types. Delete this block once the domain resolves.
:80 {
    respond "CorpusVic is at https://corpusvic.au -- this address has no certificate, so nothing is served over it." 421
}

# Worth considering, because /admin is a tool that can upload PDFs and
# run the pipeline, on the same hostname as a public site. Any of these
# on their own puts a second lock in front of it:
#
#   - restrict it to addresses you control:
#       handle /admin* {
#           @notmine not remote_ip 203.0.113.4 198.51.100.0/24
#           respond @notmine 404
#           reverse_proxy 127.0.0.1:8000
#       }
#
#   - or don't publish it at all: drop the /admin block, leave the
#     dashboard bound to loopback, and reach it over an SSH tunnel
#     (ssh -L 8000:127.0.0.1:8000 you@server) at http://127.0.0.1:8000/
#     with no --base-path.
